// ╭──────────────────────────────────────────────────────────────────╮
// │  aliases.fsh                                                     │
// │  Shared aliases for all SENAITE FSH profiles                    │
// ╰──────────────────────────────────────────────────────────────────╯

// --- Terminology CodeSystems (use for coding.system fixed values) ---
Alias: $loinc                   = http://loinc.org
Alias: $sct                     = http://snomed.info/sct
Alias: $ucum                    = http://unitsofmeasure.org
Alias: $v3-ActCode              = http://terminology.hl7.org/CodeSystem/v3-ActCode
Alias: $location-physical-type  = http://terminology.hl7.org/CodeSystem/location-physical-type
Alias: $task-status             = http://hl7.org/fhir/task-status
Alias: $obs-category            = http://terminology.hl7.org/CodeSystem/observation-category
Alias: $obs-interpretation      = http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation

// --- ValueSets (use for from ... bindings) ---
Alias: $v3-ActEncounterCode-vs      = http://terminology.hl7.org/ValueSet/v3-ActEncounterCode
Alias: $location-physical-type-vs   = http://terminology.hl7.org/ValueSet/v3-RoleCode
