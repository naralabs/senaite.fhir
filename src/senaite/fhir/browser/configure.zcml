<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser">

  <!-- @@FHIR dispatcher view -->
  <browser:page
      name="FHIR"
      for="*"
      class=".fhir.FHIR"
      permission="zope2.View"
      allowed_interface=".interfaces.IFHIR" />

  <!-- FHIR worksheet worklist states -->
  <subscriber
      for="senaite.core.browser.worksheets.view.WorksheetsView
           senaite.core.interfaces.IWorksheets"
      provides="senaite.app.listing.interfaces.IListingViewAdapter"
      factory=".worksheets.WorksheetsListingAdapter" />

</configure>
